# Encore server configuration. Copy to your process manager / container environment.
# Never commit real values.

ENCORE_ENV=development          # set to "production" when deployed
ENCORE_DATA=./data              # SQLite database, uploads and generated secret; back this up
HOST=127.0.0.1                  # use 0.0.0.0 inside a container behind a reverse proxy

# Two apps, two listeners
PORT=8081                       # organizer admin
GUEST_PORT=8082                 # guest web app
ADMIN_ORIGIN=http://127.0.0.1:8081   # production: e.g. https://admin.example.com
GUEST_ORIGIN=http://127.0.0.1:8082   # production: e.g. https://tickets.example.com (printed in table QR codes)
TRUST_PROXY=0                   # 1 only when a trusted reverse proxy sets X-Forwarded-For

# Required in production: 32+ random bytes, e.g. `python3 -c "import secrets;print(secrets.token_hex(32))"`
ENCORE_SECRET=

# SMS for guest sign-in codes and notifications.
# Unset/console = development only (codes printed in the terminal, never delivered).
# A real provider must be implemented in sms.py against its documented API before production.
SMS_PROVIDER=

# AfroPay credentials intentionally omitted until the merchant API contract is verified.
