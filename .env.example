# Encore server configuration. Copy this file to `.env` (same folder) and fill in the values:
# Encore loads `.env` at start-up, and real environment variables always take precedence.
# `.env` is git-ignored. Never commit real values; on Render set them in the service's Environment tab.

ENCORE_ENV=development          # set to "production" when deployed
ENCORE_DATA=./data              # generated secret when ENCORE_SECRET is unset, and a local PostgreSQL when ENCORE_LOCAL_DB=1
DATABASE_URL=                   # REQUIRED: postgresql://user:password@host:5432/encore
# ENCORE_LOCAL_DB=1             # development only: `npm start` runs a private PostgreSQL inside ENCORE_DATA
HOST=127.0.0.1                  # use 0.0.0.0 inside a container behind a reverse proxy

# One address serves both apps: guest app at /, organizer admin at /admin
PORT=8080
PUBLIC_ORIGIN=                  # production: e.g. https://tickets.example.com (printed in table QR codes); Render sets RENDER_EXTERNAL_URL
TRUST_PROXY=0                   # 1 only when a trusted reverse proxy sets X-Forwarded-For

# Required in production: 32+ random bytes, e.g. `openssl rand -hex 32`
ENCORE_SECRET=

# SMS for guest sign-in codes and notifications. Providers: afromessage | twilio | africastalking | geezsms | http
# AfroMessage (Ethiopia):
#   AFROMESSAGE_TOKEN=          # API token from the AfroMessage console
#   AFROMESSAGE_SENDER=Afropay  # approved sender name (default Afropay; `from` is not sent)
#   AFROMESSAGE_CALLBACK=       # optional delivery-report URL
#   AFROMESSAGE_CHALLENGE=1     # let AfroMessage generate sign-in codes (/api/challenge)
# SMS_DEBUG=1                   # log SMS requests and replies in full (includes the code) — temporary use only
# SMS_USER_AGENT=               # override the User-Agent (AfroMessage's Cloudflare rejects unknown agents: error 1010)
#   AFROMESSAGE_PREFIX= / AFROMESSAGE_POSTFIX= / AFROMESSAGE_CODE_TYPE=   # optional challenge wording
# Unset/console = development only (codes printed in the server log, never delivered).
# Other gateways: SMS_PROVIDER=http with SMS_HTTP_URL, SMS_HTTP_AUTH, SMS_HTTP_BODY. Prove delivery: npm run sms:test -- +2519...
SMS_PROVIDER=

# AfroPay credentials intentionally omitted until the merchant API contract is verified.

# Platform console for Encore operators at /admin/platform (separate from organizer accounts).
# Created or its password updated at startup. Alternatively: npm run platform-admin
ENCORE_PLATFORM_EMAIL=
ENCORE_PLATFORM_PASSWORD=
ENCORE_PLATFORM_NAME=Platform admin
