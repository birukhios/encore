# Example HTTPS reverse proxy for a VPS. Replace the domain, point DNS at the server, then run `caddy run`.
# Caddy obtains and renews TLS certificates automatically. Start Encore with PUBLIC_ORIGIN=https://tickets.example.com
# and TRUST_PROXY=1 so it sees guests' real addresses.

tickets.example.com {
	reverse_proxy 127.0.0.1:8080
	request_body {
		max_size 8MB
	}
}
