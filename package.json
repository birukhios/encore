{
  "name": "encore-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node node_modules/vite/bin/vite.js build && dotnet build backend/Encore.Api -c Release --nologo -v quiet",
    "start": "node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "check": "dotnet run --project backend/Encore.Api -c Release -- --check",
    "sms:test": "dotnet run --project backend/Encore.Api -c Release -- --sms-test",
    "sms:balance": "dotnet run --project backend/Encore.Api -c Release -- --sms-balance",
    "platform-admin": "dotnet run --project backend/Encore.Api -c Release -- --create-platform-admin"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "jsqr": "1.4.0",
    "kiwi-schema": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-arm64@17.10.0-beta.17": true
  }
}
